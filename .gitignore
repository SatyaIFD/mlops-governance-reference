# ALLOW Project 1 clean validation Parquet files to pass into LFS tracking
!project-1-credit-card-fraud/data/processed/*.parquet

# =====================================================================
# Project 2 Data Security & Storage Boundaries (Loan Default Showcase)
# =====================================================================
project-2-loan-default/data/*.csv
project-2-loan-default/data/*.zip
project-2-loan-default/data/kaggle.json

# Block all generated transaction ledgers, performance drift maps, and audit reports
project-2-loan-default/artifacts/

# ALLOW Project 2 clean validation Parquet files to pass into LFS tracking
!project-2-loan-default/data/processed/*.parquet