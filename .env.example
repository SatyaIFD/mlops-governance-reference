# Shared API Gateway & Microservice Authentication (set in local untracked .env)
EXPECTED_API_KEY=REPLACE_WITH_32_BYTE_SECRET_KEY

# Centralized MLflow Registry Configuration
MLFLOW_TRACKING_URI=sqlite:////mlflow.db

# Project 3 AML HMAC Pseudonymization Configuration
AML_HMAC_KEY_VERSION=v1
AML_HMAC_SECRET_KEY=REPLACE_WITH_32_BYTE_HMAC_SECRET
AML_PSEUDONYMIZE_ACCOUNTS=1
