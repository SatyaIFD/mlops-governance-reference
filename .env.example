# ==============================================================================
# Global MLOps Environment Configuration Template
# ==============================================================================
# DO NOT PUT REAL SECRETS IN THIS FILE.
# Copy this file to '.env' and populate the values for your local environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global Infrastructure & Routing
# ------------------------------------------------------------------------------
# Environment mode: development, staging, or production
APP_ENV=development

# ------------------------------------------------------------------------------
# 2. Project 1: Credit Card Fraud Detection
# ------------------------------------------------------------------------------
# Port for the Project 1 FastAPI Inference Service
P1_PORT=8000
# Directory path to the Project 1 MLflow SQLite database
P1_MLFLOW_TRACKING_URI=sqlite:///project-1-credit-card-fraud/mlflow.db

# ------------------------------------------------------------------------------
# 3. Project 2: Loan Default Showcase
# ------------------------------------------------------------------------------
# Port for the Project 2 FastAPI Inference Service
P2_PORT=8001
# Directory path to the Project 2 MLflow SQLite database
P2_MLFLOW_TRACKING_URI=sqlite:///project-2-loan-default/mlflow.db

# ------------------------------------------------------------------------------
# 4. Project 3: Anti-Money Laundering Streaming
# ------------------------------------------------------------------------------
# Location of the active AML streaming model artifact
P3_MODEL_ARTIFACT_PATH=project-3-aml-streaming/artifacts/aml_model.joblib

# ------------------------------------------------------------------------------
# 5. Cloud Deployment (GCP & Cloudflare - Future Use)
# ------------------------------------------------------------------------------
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_REGION=us-central1
# CLOUDFLARE_API_TOKEN=your-cloudflare-dns-token
